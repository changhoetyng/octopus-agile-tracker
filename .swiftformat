# SwiftFormat Configuration File
# https://github.com/nicklockwood/SwiftFormat/blob/master/Rules.md

# Indentation
--indent 4
--tabwidth 4
--smarttabs enabled

# Line wrapping
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--wrapconditions before-first
--wraptypealiases before-first

# Spacing
--trimwhitespace always
--insertlines enabled
--removelines enabled
--lineaftermarks enabled
--linebeforemarks enabled

# Braces
--braces spaced
--elseposition same-line
--emptybraces spaced
--emptybraces spaced

# Commas
--commas always
--decimalgrouping 3,4
--binarygrouping 4,8
--octalgrouping 4,8
--hexgrouping 4,8
--fractiongrouping enabled
--exponentgrouping enabled
--hexliteralcase uppercase
--exponentcase lowercase

# Operators
--operatorfunc spaced
--preferoperatorfunc enabled
--spacedoperators +, -, *, /, %, =, ==, !=, <, >, <=, >=, +=, -=, *=, /=, %=, &=, |=, ^=, <<=, >>=

# Other
--semicolons never
--trailingcommas always
--header strip
--stripunusedargs closure-only
--xcodeindentation enabled
--linebreakafterguard enabled
--redundanttype enabled
--redundantfileprivate enabled
--redundantpublicacls enabled
--redundantinternalacls enabled
--redundantprivateacls enabled
--redundantacl enabled
--redundantlet enabled
--redundantvar enabled
--redundantget enabled
--redundantself enabled
--redundantinit enabled
--redundantfunc enabled
--redundanttypealias enabled
--redundantimport enabled
--redundantmark enabled
--redundantconformance enabled
--redundantpattern enabled
--redundantrawvalues enabled
--redundanttypeannotation enabled
--redundantbackticks enabled
--redundantranges enabled
--redundantfileprivate enabled
--redundantpublicacls enabled
--redundantinternalacls enabled
--redundantprivateacls enabled
--redundantacl enabled
--redundantlet enabled
--redundantvar enabled
--redundantget enabled
--redundantself enabled
--redundantinit enabled
--redundantfunc enabled
--redundanttypealias enabled
--redundantimport enabled
--redundantmark enabled
--redundantconformance enabled
--redundantpattern enabled
--redundantrawvalues enabled
--redundanttypeannotation enabled
--redundantbackticks enabled
--redundantranges enabled
